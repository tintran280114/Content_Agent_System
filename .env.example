# Copy to .env and keep every real value local and private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fine-grained GitHub PAT: Account permissions -> Models: Read-only.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Application-side daily guards. The CLI stops before exceeding these limits.
CONTENT_AGENT_GEMINI_MAX_REQUESTS_PER_DAY=100
CONTENT_AGENT_GEMINI_MAX_TOKENS_PER_DAY=100000
CONTENT_AGENT_GROQ_MAX_REQUESTS_PER_DAY=300
CONTENT_AGENT_GROQ_MAX_TOKENS_PER_DAY=100000
CONTENT_AGENT_GITHUB_MODELS_MAX_REQUESTS_PER_DAY=100
CONTENT_AGENT_GITHUB_MODELS_MAX_TOKENS_PER_DAY=100000
