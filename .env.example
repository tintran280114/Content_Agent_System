# Copy to .env and keep every real value local and private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fine-grained GitHub PAT: Account permissions -> Models: Read-only.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Meta delivery. Paste/replace tokens here when they expire; never put them in Markdown.
# `python run.py --list-accounts` reports whether each referenced variable is present
# without printing its value.
META_GRAPH_API_VERSION=v25.0
THREADS_GRAPH_API_VERSION=v1.0
META_REQUEST_TIMEOUT_SECONDS=30
# Example/template slots:
FACEBOOK_EXAMPLE_PAGE_TOKEN=
THREADS_EXAMPLE_USER_TOKEN=
# Slots referenced by the bundled account policies:
FACEBOOK_COMMUNITY_PAGE_TOKEN=
THREADS_RESPONSIBLE_AI_TOKEN=
# Optional ISO-8601 expiry when a token is supplied through env.
THREADS_RESPONSIBLE_AI_TOKEN_EXPIRES_AT=

# Threads OAuth and encrypted token rotation.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8501
THREADS_TOKEN_REFRESH_DAYS=7
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTENT_AGENT_TOKEN_ENCRYPTION_KEY=
CONTENT_AGENT_TOKEN_STORE=artifacts/meta_tokens.enc

# Application-side daily guards. The CLI stops before exceeding these limits.
CONTENT_AGENT_GEMINI_MAX_REQUESTS_PER_DAY=100
CONTENT_AGENT_GEMINI_MAX_TOKENS_PER_DAY=100000
CONTENT_AGENT_GROQ_MAX_REQUESTS_PER_DAY=300
CONTENT_AGENT_GROQ_MAX_TOKENS_PER_DAY=100000
CONTENT_AGENT_GITHUB_MODELS_MAX_REQUESTS_PER_DAY=100
CONTENT_AGENT_GITHUB_MODELS_MAX_TOKENS_PER_DAY=100000
